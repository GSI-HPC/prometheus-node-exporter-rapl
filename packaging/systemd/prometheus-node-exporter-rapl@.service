#
# Instantiated by systemd for every powercap zone the packaged udev rule
# tags: SYSTEMD_WANTS names this template, so systemd fills in the zone's
# escaped sysfs path as the instance and %f expands to that path again
# (sys-devices-virtual-powercap-intel\x2drapl-intel\x2drapl:0 becomes
# /sys/devices/virtual/powercap/intel-rapl/intel-rapl:0).
#
# Runs as root on purpose: the counter is a root-owned sysfs attribute, and
# under SELinux a service started from init_t without a policy of its own
# lands in unconfined_service_t, which unlike udev_t may setattr sysfs
# files. The instance is a plain oneshot without RemainAfterExit so that a
# later add event for the same zone (module reload, udevadm trigger) starts
# it again.

[Unit]
Description=Grant group rapl read access to RAPL energy counter %f
Documentation=https://github.com/GSI-HPC/prometheus-node-exporter-rapl
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=%f/energy_uj

[Service]
Type=oneshot
ExecStart=/usr/bin/chgrp rapl %f/energy_uj
ExecStart=/usr/bin/chmod 0440 %f/energy_uj

# Hardening. chgrp needs CAP_CHOWN; chmod on a root-owned file by root
# needs no capability. /sys stays writable under ProtectSystem=strict, and
# ProtectKernelTunables= must stay off because it would make it read-only.
CapabilityBoundingSet=CAP_CHOWN
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=none
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077
